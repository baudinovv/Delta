{
  "expo": {
    "name": "Delta",
    "slug": "delta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.delta.pilot",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "ru"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2A5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.delta.pilot",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Delta uses the camera to photograph meals and estimate calories.",
          "photosPermission": "Delta reads a photo you pick to estimate its calories."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Delta uses the camera to scan barcodes and photograph meals.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Delta reads your workouts, steps and active energy to show your full training load and give better coaching advice.",
          "NSHealthUpdateUsageDescription": "Delta saves your logged strength sessions to Apple Health as workouts.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Delta uses the microphone for voice messages to your AI coach."
        }
      ]
    ],
    "scheme": "delta",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0A0C0F"
  }
}
